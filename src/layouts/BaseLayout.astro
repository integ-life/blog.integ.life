---
import { absoluteUrl, COPY, DEFAULT_LANG, LANGUAGES, SITE, type Lang } from '../lib/site';
import '../styles/global.css';
import '@integ-life/ui/styles.css';
import '../styles/shared-layout.css';

type AlternateLink = {
  lang: Lang;
  path: string;
};

type Props = {
  title?: string;
  description?: string;
  lang?: Lang;
  image?: string;
  type?: 'website' | 'article';
  alternates?: AlternateLink[];
};

const {
  title = SITE.defaultTitle,
  description = SITE.defaultDescription,
  lang = DEFAULT_LANG,
  image = SITE.defaultOgImage,
  type = 'website',
  alternates = [
    { lang: 'en', path: '/' },
    { lang: 'zh', path: '/zh/' },
  ],
} = Astro.props;

const copy = COPY[lang];
const pageTitle = title === SITE.defaultTitle ? title : `${title} | ${SITE.name}`;
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(image);
const switchAlt = alternates.find((alternate) => alternate.lang !== lang);
const rssPath = lang === 'en' ? '/rss.xml' : '/zh/rss.xml';
---

<!doctype html>
<html lang={LANGUAGES[lang].locale} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (() => {
        const key = 'integ-ui.appearance';
        const stored = localStorage.getItem(key) || localStorage.getItem('blog-theme');
        if (stored && !localStorage.getItem(key)) localStorage.setItem(key, stored);
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.integTheme = stored && stored !== 'system' ? stored : (prefersDark ? 'dark' : 'light');
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} ${copy.rss}`} href={absoluteUrl(rssPath)} />
    {alternates.map((alternate) => (
      <link rel="alternate" hreflang={LANGUAGES[alternate.lang].locale} href={absoluteUrl(alternate.path)} />
    ))}
    {alternates.find((alternate) => alternate.lang === DEFAULT_LANG) && (
      <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates.find((alternate) => alternate.lang === DEFAULT_LANG)?.path ?? '/')} />
    )}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#6366f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-PW2W0GXC95"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PW2W0GXC95');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <integ-family-bar product="blog" name="Field Notes" locale={lang} home-href={lang === 'en' ? '/' : '/zh/'}>
      <div data-il-actions>{switchAlt && <a class="il-control" href={switchAlt.path}>{copy.switchLanguage}</a>}</div>
    </integ-family-bar>
    <nav class="site-nav shared-editorial-nav" aria-label="Primary navigation">
      <a href={lang === 'en' ? '/#products' : '/zh/#products'}>{copy.navProducts}</a>
      <a href={lang === 'en' ? '/' : '/zh/'}>{copy.navArticles}</a>
      <a href={lang === 'en' ? '/archive/' : '/zh/archive/'}>{copy.navArchive}</a>
      <a href={lang === 'en' ? '/tags/' : '/zh/tags/'}>{copy.navTags}</a>
    </nav>
    <script>import '@integ-life/ui/static';</script>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>{copy.footer}</p>
        <div>
          <a href={absoluteUrl(rssPath)}>{copy.rss}</a>
          <a href="https://integ.life">integ.life</a>
        </div>
      </div>
    </footer>


  </body>
</html>
