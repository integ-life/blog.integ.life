---
import BaseLayout from './BaseLayout.astro';
import { absoluteUrl, COPY, formatDate, SITE, type Lang } from '../lib/site';
import { getTranslation, tagToSlug, type BlogPost } from '../lib/posts';
import PostVisual from '../components/PostVisual.astro';

type Props = {
  post: BlogPost;
};

const { post } = Astro.props;
const lang: Lang = post.lang;
const copy = COPY[lang];
const translation = getTranslation(post);
const Content = post.Content;
const alternates = [
  { lang: post.lang, path: post.url },
  ...(translation ? [{ lang: translation.lang, path: translation.url }] : []),
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.description,
  image: absoluteUrl(post.heroImage),
  datePublished: post.pubDateValue.toISOString(),
  dateModified: (post.updatedDateValue ?? post.pubDateValue).toISOString(),
  author: {
    '@type': 'Person',
    name: SITE.author,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.name,
  },
  mainEntityOfPage: absoluteUrl(post.url),
};
---

<BaseLayout
  title={post.title}
  description={post.description}
  lang={lang}
  image={post.heroImage}
  type="article"
  alternates={alternates}
>
  <article class="article-shell">
    <header class="article-header">
      <div class="article-header__meta">
        <time datetime={post.pubDateValue.toISOString()}>{formatDate(post.pubDateValue, lang)}</time>
        <span>{copy.byline}</span>
      </div>
      <h1>{post.title}</h1>
      <p>{post.description}</p>
      <div class="article-header__tags" aria-label="Tags">
        {post.tags.map((tag) => (
          <a href={lang === 'en' ? `/tags/${tagToSlug(tag)}/` : `/zh/tags/${tagToSlug(tag)}/`}>{tag}</a>
        ))}
      </div>
      {translation && <a class="translation-link" href={translation.url}>{copy.switchLanguage}</a>}
    </header>
    <PostVisual post={post} lang={lang} className="article-hero" />
    <div class="prose">
      <Content />
    </div>
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>
