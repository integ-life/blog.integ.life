---
import PostVisual from '../components/PostVisual.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { COPY, formatDate } from '../lib/site';
import { getPosts } from '../lib/posts';

const lang = 'en';
const copy = COPY[lang];
const posts = getPosts(lang);
---

<BaseLayout
  title={copy.archiveTitle}
  description="Every English article published on Integ Life Blog."
  lang={lang}
  alternates={[{ lang: 'en', path: '/archive/' }, { lang: 'zh', path: '/zh/archive/' }]}
>
  <section class="listing-shell">
    <header class="listing-header">
      <p class="eyebrow">{copy.homeEyebrow}</p>
      <h1>{copy.archiveTitle}</h1>
    </header>
    <div class="archive-list">
      {posts.map((post) => (
        <article class="article-row">
          <a class="article-row__visual" href={post.url} aria-label={post.title}>
            <PostVisual post={post} lang={lang} compact decorative />
          </a>
          <div class="article-row__body">
            <time datetime={post.pubDateValue.toISOString()}>{formatDate(post.pubDateValue, lang)}</time>
            <h2><a href={post.url}>{post.title}</a></h2>
            <p>{post.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
