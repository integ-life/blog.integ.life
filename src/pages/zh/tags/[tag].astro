---
import PostCard from '../../../components/PostCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { COPY } from '../../../lib/site';
import { getPostsByTag, getTagGroups, type BlogPost } from '../../../lib/posts';

type Props = {
  group: {
    tag: string;
    slug: string;
    posts: BlogPost[];
  };
};

export function getStaticPaths() {
  return getTagGroups('zh').map((group) => ({
    params: { tag: group.slug },
    props: { group: getPostsByTag('zh', group.slug) },
  }));
}

const lang = 'zh';
const copy = COPY[lang];
const { group } = Astro.props as Props;
const hasEn = getTagGroups('en').some((g) => g.slug === group.slug);
---

<BaseLayout
  title={group.tag}
  description={`标签为 ${group.tag} 的 Field Notes 中文文章。`}
  lang={lang}
  alternates={hasEn
    ? [{ lang: 'en', path: `/tags/${group.slug}/` }, { lang: 'zh', path: `/zh/tags/${group.slug}/` }]
    : [{ lang: 'zh', path: `/zh/tags/${group.slug}/` }]}
>
  <section class="listing-shell">
    <header class="listing-header">
      <p class="eyebrow">{copy.tagsTitle}</p>
      <h1>{group.tag}</h1>
    </header>
    <div class="post-grid">
      {group.posts.map((post) => <PostCard post={post} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
