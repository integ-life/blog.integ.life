---
import type { Lang } from '../lib/site';
import type { BlogPost } from '../lib/posts';
import ExplainerVisual from './ExplainerVisual.astro';

type Props = {
  post: BlogPost;
  lang: Lang;
  compact?: boolean;
  decorative?: boolean;
  className?: string;
};

const { post, lang, compact = false, decorative = false, className = '' } = Astro.props;
const imageClass = ['post-visual-image', compact ? 'compact' : '', className].filter(Boolean).join(' ');
---

{post.visualMode === 'hero' ? (
  <img
    class={imageClass}
    src={post.heroImage}
    alt={decorative ? '' : post.heroAlt}
    loading={compact ? 'lazy' : 'eager'}
    decoding="async"
  />
) : (
  <ExplainerVisual visual={post.visualKey} lang={lang} compact={compact} decorative={decorative} />
)}
