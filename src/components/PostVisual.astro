---
import type { Lang } from '../lib/site';
import { getPostCover, type BlogPost } from '../lib/posts';

type Props = {
  post: BlogPost;
  lang: Lang;
  compact?: boolean;
  decorative?: boolean;
  className?: string;
};

const { post, compact = false, decorative = false, className = '' } = Astro.props;
const cover = getPostCover(post);
const imageClass = ['post-visual-image', compact ? 'compact' : '', className].filter(Boolean).join(' ');
---

<img
  class={imageClass}
  src={cover.src}
  alt={decorative ? '' : cover.alt}
  width="1280"
  height="800"
  loading={compact ? 'lazy' : 'eager'}
  decoding="async"
/>
