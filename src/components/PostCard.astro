---
import { COPY, formatDate, type Lang } from '../lib/site';
import { tagToSlug, type BlogPost } from '../lib/posts';
import ExplainerVisual from './ExplainerVisual.astro';

type Props = {
  post: BlogPost;
  lang: Lang;
  compact?: boolean;
};

const { post, lang, compact = false } = Astro.props;
const copy = COPY[lang];
---

<article class:list={['post-card', { compact }]}>
  <a class="post-card__image-link" href={post.url} aria-label={post.title}>
    <ExplainerVisual visual={post.visualKey} lang={lang} compact={compact} decorative />
  </a>
  <div class="post-card__body">
    <div class="post-card__meta">
      <time datetime={post.pubDateValue.toISOString()}>{formatDate(post.pubDateValue, lang)}</time>
      <span>{copy.byline}</span>
    </div>
    <h2><a href={post.url}>{post.title}</a></h2>
    <p>{post.description}</p>
    <div class="post-card__footer">
      <div class="tags" aria-label="Tags">
        {post.tags.map((tag) => (
          <a href={lang === 'en' ? `/tags/${tagToSlug(tag)}/` : `/zh/tags/${tagToSlug(tag)}/`}>{tag}</a>
        ))}
      </div>
      <a class="read-link" href={post.url}>{copy.readMore}</a>
    </div>
  </div>
</article>
